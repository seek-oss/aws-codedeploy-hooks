{
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm run --recursive build",
    "changeset": "changeset",
    "codegen": "pnpm run --recursive codegen",
    "format": "skuba format",
    "lint": "skuba lint",
    "release": "pnpm run --silent build && changeset publish",
    "stage": "changeset version && pnpm run --silent codegen && pnpm run --silent format",
    "test": "skuba test",
    "test:ci": "skuba test --coverage",
    "test:watch": "skuba test --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.19.2",
    "rolldown": "1.0.1",
    "skuba": "16.4.2"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.28.6",
  "skuba": {
    "entryPoint": "packages/hooks/src/index.ts",
    "template": "oss-npm-package",
    "type": "package",
    "version": "16.4.0"
  }
}
